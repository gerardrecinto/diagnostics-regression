{
 "title": "Diagnostics pipeline and API",
 "uid": "diaglab",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Rows by stage",
   "type": "bargauge",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "diaglab_pipeline_rows",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Reject rate",
   "type": "stat",
   "gridPos": {
    "h": 7,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "diaglab_pipeline_rows{stage=\"rejected_rows\"} / ignoring(stage) diaglab_pipeline_rows{stage=\"raw_rows\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Summary age",
   "type": "stat",
   "gridPos": {
    "h": 7,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "diaglab_summary_age_seconds",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Requests per second by route",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(diaglab_http_requests_total[5m]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "p95 latency",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 6,
    "x": 12,
    "y": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(diaglab_http_request_seconds_bucket[5m])))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "5xx ratio",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 6,
    "x": 18,
    "y": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(rate(diaglab_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(diaglab_http_requests_total[5m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  }
 ]
}